@model RaceDayMVC.Models.Result

@{
    ViewData["Title"] = "Add Result";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Add Race Result</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="EnrollmentID" class="form-label">Enrollment ID</label>
            <input asp-for="EnrollmentID" type="number" class="form-control" />
            <span asp-validation-for="EnrollmentID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">Finish Time</label>
            <input asp-for="FinishTime" class="form-control"
                   placeholder="e.g. 01:35:20" />
            <span asp-validation-for="FinishTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FinishPosition" class="form-label">Finish Position</label>
            <input asp-for="FinishPosition" type="number" class="form-control" />
            <span asp-validation-for="FinishPosition" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="">Select status</option>
                <option value="Completed">Completed</option>
                <option value="Did Not Finish">Did Not Finish</option>
                <option value="Disqualified">Disqualified</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Save Result</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
