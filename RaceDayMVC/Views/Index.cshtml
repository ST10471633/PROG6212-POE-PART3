@model RaceDayMVC.Controllers.UserController.ProfileResponse

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>My Profile</h2>

    @if (Model == null)
    {
        <p class="alert alert-warning">Profile information is unavailable.</p>
    }
    else
    {
        <div class="card mt-3">
            <div class="card-header">
                Account Information
            </div>
            <div class="card-body">
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Role:</strong> @Model.Role</p>
            </div>
        </div>
    }

    <a asp-controller="Home" asp-action="Index"
       class="btn btn-secondary mt-3">Back Home</a>
</div>
